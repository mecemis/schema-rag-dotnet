# Copy to .env and replace both password placeholders before starting Compose.
# Use an absolute path if you want the data outside this repository.
SCHEMA_RAG_DATA_ROOT=./.data

POSTGRES_DB=schema_rag
POSTGRES_USER=schema_rag_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_READONLY_PASSWORD=replace-with-a-different-readonly-password

API_PORT=8080
API_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
QDRANT_PORT=6333
OLLAMA_PORT=11434

OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
QDRANT_COLLECTION_NAME=schema_documents
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_COLLECTION_NAME=semantic_query_cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_MINUTES=1440
SCHEMA_RETRIEVAL_COUNT=4
MAX_TABLES_PER_INDEX=100
EMBEDDING_CONCURRENCY=4
QUERY_TIMEOUT_SECONDS=5
QUERY_MAX_ROWS=100

# Optional values used with compose.external-db.example.yaml. The PostgreSQL
# role must have SELECT-only grants and default_transaction_read_only=on.
# EXTERNAL_DB_DISPLAY_NAME=External reporting database
# EXTERNAL_DB_CONNECTION_STRING=
# EXTERNAL_DB_SCHEMA=public
